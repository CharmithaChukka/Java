
//program to illustrate call by reference mechanism
class Test
{
 int a, b;
 Test(int i, int j)
 {
 a=i;
 b=j;
 }
 void change(Test x)
 {
 x.a*=2;
 x.b/=2;
 }
}
class CallByReference
{
 public static void main(String args[])
 {
 Test t=new Test(15,20);
 System.out.println(“Before method call:”+”a=”+t.a+” “+”b=”+t.b);
 t.change(t);
 System.out.println(“After method call:”+”a=”+t.a+” “+”b=”+t.b);
 }
}
Output-
Before method call: a=15 b=20  
After method call: a=30 b=10
