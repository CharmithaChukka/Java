class A
{
int a, b;
A()
{
a=0;
b=0;
}
A(int x)
{
a=x;
b=5;
}
A(int x, int y)
{
a=x;
b=y;
}
void display()
{
System.out.println(a+”“+b);
}
}
class ConstructorOverloadDemo
{
public static void main(String args[])
{
A a1=new A();
A a2=new A(3);
A a3=new A(10,20);
a1.display();
a2.display();
a3.display();
}
}
output-
0 0
3 5
10 20
